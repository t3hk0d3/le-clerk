{
  "description": "Le Clerk: report the session's Claude Code process, brief new conversations on what they hold, remind to arm clerk wait, show pending notices, release on session end. Every hook fails open.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/clerk-hook.sh\" session-start", "timeout": 3 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/clerk-hook.sh\" stop", "timeout": 3 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/clerk-hook.sh\" pre-tool-use", "timeout": 3 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/clerk-hook.sh\" session-end", "timeout": 1.5 }
        ]
      }
    ]
  }
}
